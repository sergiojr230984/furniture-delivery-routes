# Supabase — get these from your project at https://app.supabase.com  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service-role key — server-only. NEVER expose to the browser.
# Used for admin actions like creating driver/staff user accounts.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── WhatsApp (Meta Business Cloud API) ──────────────────────────────────────
# Meta Business Manager → your WhatsApp Business Account → API Setup.
# Sends the customer an "on the way" message when a driver marks a stop out
# for delivery, and a "delivery is tomorrow" reminder via the daily cron
# (see the "crons" entry in vercel.json).
# Leave blank to disable automatic WhatsApp notifications.
WHATSAPP_ACCESS_TOKEN="your-permanent-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_API_VERSION="v21.0"

# Business-initiated WhatsApp messages must use a pre-approved Message
# Template (Meta Business Manager → Account tools → Message templates).
# Create two templates with these exact body variable counts:
#   delivery_reminder  — {{1}} name  {{2}} order #  {{3}} date  {{4}} time window
#   out_for_delivery   — {{1}} name  {{2}} address
# Then set the names/language below to match what you created & got approved.
WHATSAPP_TEMPLATE_DAY_BEFORE="delivery_reminder"
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY="out_for_delivery"
WHATSAPP_TEMPLATE_LANG="en_US"

# Shared secret the day-before reminder cron must present as
# `Authorization: Bearer <secret>`. Generate any long random string — Vercel
# sends it automatically for jobs defined in vercel.json once this env var
# is set on the project.
CRON_SECRET="a-long-random-string"

# ── Google Calendar ───────────────────────────────────────────────────────────
# 1. Create a Service Account in Google Cloud Console (enable Calendar API).
# 2. Download the JSON key → base-64 encode it:
#      base64 -i service-account.json | tr -d '\n'
# 3. Share your Google Calendar with the service account's email address
#    (grant "Make changes to events").
# 4. Paste the calendar ID from Calendar Settings → Integrate calendar.
# Leave blank to disable automatic route calendar sync.
GOOGLE_SERVICE_ACCOUNT_JSON="base64-encoded-service-account-json"
GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"
