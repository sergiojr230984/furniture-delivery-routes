# ── Database ──────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance. For local dev, a local Postgres works fine:
#   createdb belliza
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belliza"

# Separate database for integration tests (never the dev/demo database).
# Set up once with: npm run db:test:setup
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belliza_test"

# ── Sessions ──────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Operating mode ────────────────────────────────────────────────────────────
# One of: demo | pilot | marketplace
#   demo        - seeded fictional data, all external integrations simulated,
#                 no real charges/payouts/messages are ever sent.
#   pilot       - internal Belliza stores + internal crew only; external
#                 retailer/provider onboarding is disabled; internal delivery
#                 costs are recorded without real card charges.
#   marketplace - external retailers and approved delivery providers enabled.
APP_MODE="demo"

# Base URL used to build tracking / secure-access links in notifications.
APP_BASE_URL="http://localhost:3000"

# ── File storage ──────────────────────────────────────────────────────────────
# Local private upload directory (proof-of-delivery photos, signatures,
# provider documents), used only when R2 below is not configured. Not
# viable on a serverless host (e.g. Vercel) — files won't persist.
UPLOADS_DIR=".data/uploads"

# Cloudflare R2 (S3-compatible). Set all four to switch lib/storage.ts from
# local disk to a private bucket with short-lived presigned URLs — required
# for any serverless deploy (Vercel, etc). Create a bucket at
# dash.cloudflare.com → R2, then Manage API Tokens → create a token scoped
# to that bucket for the access key / secret.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ── Stripe (test mode) ────────────────────────────────────────────────────────
# Leave blank to run with the in-app demo payment adapter (no real charges).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ── Twilio SMS ────────────────────────────────────────────────────────────────
# Leave blank to route SMS to the in-app demo notifications outbox instead.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── WhatsApp (Meta Business Cloud API) ──────────────────────────────────────
# Preferred over SMS whenever configured (lib/notify.ts#sendCustomerUpdate),
# since most retail customers in this market use WhatsApp. Leave blank to
# fall back to Twilio SMS above (or the demo outbox if that's blank too).
# Get credentials at Meta Business Manager → your WhatsApp Business Account
# → API Setup.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANG="en_US"

# Business-initiated WhatsApp messages must use a pre-approved Message
# Template (Meta Business Manager → Account tools → Message templates).
# Create these four templates with exactly these body variable counts, then
# set the names below to match what you created & got approved:
#   booking_confirmed  — {{1}} order #  {{2}} date  {{3}} time window  {{4}} tracking link
#   out_for_delivery   — {{1}} order #  {{2}} tracking link
#   delivery_completed — {{1}} order #  {{2}} tracking link
#   delivery_exception — {{1}} order #  {{2}} reason  {{3}} tracking link
#   delivery_reminder  — {{1}} name  {{2}} order #  {{3}} date  {{4}} time window
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED="booking_confirmed"
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY="out_for_delivery"
WHATSAPP_TEMPLATE_DELIVERED="delivery_completed"
WHATSAPP_TEMPLATE_EXCEPTION="delivery_exception"
WHATSAPP_TEMPLATE_DAY_BEFORE="delivery_reminder"

# Shared secret the day-before reminder cron must present as
# `Authorization: Bearer <secret>`. Generate any long random string — Vercel
# sends it automatically for jobs defined in vercel.json once this env var
# is set on the project.
CRON_SECRET=""

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to route email to the in-app demo notifications outbox instead.
SMTP_URL=""
EMAIL_FROM="Belliza Delivery <delivery@belliza.example>"

# ── Map / geocoding (optional) ────────────────────────────────────────────────
# Leave blank to disable the dispatch map view (list/calendar views still work).
NEXT_PUBLIC_MAPBOX_TOKEN=""
